@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix kg: <http://causalkg.example.org/child/> .

<#ChildMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "kgs/csvs/child.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;
    rr:subjectMap [
        rr:template "http://causalkg.example.org/child/child_{index}" ;
        rr:class kg:Child
    ] ;
    rr:predicateObjectMap [
        rr:predicate kg:ductFlow ;
        rr:objectMap [ rml:reference "DuctFlow" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate kg:grunting ;
        rr:objectMap [ rml:reference "Grunting" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate kg:age ;
        rr:objectMap [ rml:reference "Age" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate kg:lvh ;
        rr:objectMap [ rml:reference "LVH" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate kg:ruqO2 ;
        rr:objectMap [ rml:reference "RUQO2" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate kg:cardiacMixing ;
        rr:objectMap [ rml:reference "CardiacMixing" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate kg:gruntingReport ;
        rr:objectMap [ rml:reference "GruntingReport" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate kg:xrayReport ;
        rr:objectMap [ rml:reference "XrayReport" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate kg:disease ;
        rr:objectMap [ rml:reference "Disease" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate kg:lungParench ;
        rr:objectMap [ rml:reference "LungParench" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate kg:sick ;
        rr:objectMap [ rml:reference "Sick" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate kg:hypDistrib ;
        rr:objectMap [ rml:reference "HypDistrib" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate kg:co2 ;
        rr:objectMap [ rml:reference "CO2" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate kg:co2Report ;
        rr:objectMap [ rml:reference "CO2Report" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate kg:lowerBodyO2 ;
        rr:objectMap [ rml:reference "LowerBodyO2" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate kg:birthAsphyxia ;
        rr:objectMap [ rml:reference "BirthAsphyxia" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate kg:hypoxiaInO2 ;
        rr:objectMap [ rml:reference "HypoxiaInO2" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate kg:chestXray ;
        rr:objectMap [ rml:reference "ChestXray" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate kg:lvhReport ;
        rr:objectMap [ rml:reference "LVHreport" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate kg:lungFlow ;
        rr:objectMap [ rml:reference "LungFlow" ]
    ] .
