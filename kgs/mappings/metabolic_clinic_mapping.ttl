@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix kg: <http://causalkg.example.org/clinic/> .

# ------------------------------------------------------------------
# A-Box: one ClinicPatient per CSV row.
# ------------------------------------------------------------------

<#ClinicPatientMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "kgs/csvs/metabolic_clinic.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;
    rr:subjectMap [
        rr:template "http://causalkg.example.org/clinic/patient/patient_{index}" ;
        rr:class kg:ClinicPatient
    ] ;
    rr:predicateObjectMap [ 
        rr:predicate kg:ageGroup ; 
        rr:objectMap [ rml:reference "AgeGroup" ] 
    ] ;
    rr:predicateObjectMap [ 
        rr:predicate kg:sex ; 
        rr:objectMap [ rml:reference "Sex" ] 
    ] ;
    rr:predicateObjectMap [ 
        rr:predicate kg:smokerType ; 
        rr:objectMap [ rml:reference "Smoker" ] 
    ] ;
    rr:predicateObjectMap [ 
        rr:predicate kg:activityLevel ; 
        rr:objectMap [ rml:reference "ActivityLevel" ] 
    ] ;
    rr:predicateObjectMap [ 
        rr:predicate kg:bmi ; 
        rr:objectMap [ rml:reference "BMI" ;
        rr:datatype xsd:float ]
    ] ;
    rr:predicateObjectMap [ 
        rr:predicate kg:fastingGlucose ; 
        rr:objectMap [ rml:reference "FastingGlucose" ;
        rr:datatype xsd:float ]
    ] ;
    rr:predicateObjectMap [ 
        rr:predicate kg:systolicBP ; 
        rr:objectMap [ rml:reference "SystolicBP" ;
        rr:datatype xsd:float ]
    ] ;
    rr:predicateObjectMap [ 
        rr:predicate kg:cholesterol ; 
        rr:objectMap [ rml:reference "Cholesterol" ;
        rr:datatype xsd:float ]
    ] ;
    rr:predicateObjectMap [ 
        rr:predicate kg:hypertension ; 
        rr:objectMap [ rml:reference "Hypertension" ] 
    ] ;
    rr:predicateObjectMap [ 
        rr:predicate kg:diabetesStatus ; 
        rr:objectMap [ rml:reference "Diabetes" ] 
    ] .
