kg:receives a owl:ObjectProperty ;
    rdfs:label "receives" ;
    rdfs:comment "The therapy regimen the patient receives." ;
    rdfs:domain kg:Patient ;
    rdfs:range kg:Therapy .

kg:region a owl:DatatypeProperty ;
    rdfs:label "Region" ;
    rdfs:comment "Geographic region of the hospital." ;
    rdfs:domain kg:Hospital ;
    rdfs:range xsd:string .

kg:smoking a owl:DatatypeProperty ;
    rdfs:label "Smoking" ;
    rdfs:comment "Smoking status of the patient, a strong driver of disease progression." ;
    rdfs:domain kg:Patient ;
    rdfs:range xsd:string .

kg:survival a owl:DatatypeProperty ;
    rdfs:label "Survival" ;
    rdfs:comment "Overall survival category, influenced by disease stage, care quality and treatment toxicity." ;
    rdfs:domain kg:Patient ;
    rdfs:range xsd:string .

kg:toxicity a owl:DatatypeProperty ;
    rdfs:label "Toxicity" ;
    rdfs:comment "Observed toxicity, driven by drug class and dosage." ;
    rdfs:domain kg:Therapy ;
    rdfs:range xsd:string .

kg:treatedAt a owl:ObjectProperty ;
    rdfs:label "treated at" ;
    rdfs:comment "The hospital where the patient is treated." ;
    rdfs:domain kg:Patient ;
    rdfs:range kg:Hospital .

kg:tumorStage a owl:DatatypeProperty ;
    rdfs:label "Tumor Stage" ;
    rdfs:comment "Disease stage, influenced by age, smoking, genetics and environmental exposure." ;
    rdfs:domain kg:Patient ;
    rdfs:range xsd:string .

