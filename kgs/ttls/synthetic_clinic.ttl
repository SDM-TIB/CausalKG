@prefix kg: <http://causalkg.example.org/synthetic/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kg:age a owl:DatatypeProperty ;
    rdfs:label "Age" ;
    rdfs:comment "Patient age group at diagnosis." ;
    rdfs:domain kg:Patient ;
    rdfs:range xsd:string .

kg:airPollution a owl:DatatypeProperty ;
    rdfs:label "Air Pollution" ;
    rdfs:comment "Local air-pollution level, which depends on the region." ;
    rdfs:domain kg:Hospital ;
    rdfs:range xsd:string .

kg:careQuality a owl:DatatypeProperty ;
    rdfs:label "Care Quality" ;
    rdfs:comment "Quality of care provided by the hospital." ;
    rdfs:domain kg:Hospital ;
    rdfs:range xsd:string .

kg:dosage a owl:DatatypeProperty ;
    rdfs:label "Dosage" ;
    rdfs:comment "Dosage level of the therapy, chosen from the patient's disease stage." ;
    rdfs:domain kg:Therapy ;
    rdfs:range xsd:string .

kg:drugClass a owl:DatatypeProperty ;
    rdfs:label "Drug Class" ;
    rdfs:comment "Pharmacological class of the administered drug." ;
    rdfs:domain kg:Therapy ;
    rdfs:range xsd:string .

kg:geneticRisk a owl:DatatypeProperty ;
    rdfs:label "Genetic Risk" ;
    rdfs:comment "Genetic susceptibility of the patient." ;
    rdfs:domain kg:Patient ;
    rdfs:range xsd:string .

