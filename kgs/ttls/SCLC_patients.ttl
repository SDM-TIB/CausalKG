@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix kg: <http://causalkg.example.org/sclc/> .

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix kg: <http://causalkg.example.org/sclc/> .

### Class Definition ###

kg:SCLCPatient a owl:Class ;
    rdfs:label "Small Cell Lung Cancer Patient" ;
    rdfs:comment "A patient diagnosed with Small Cell Lung Cancer (SCLC), a highly aggressive neuroendocrine tumor of the lung characterized by rapid growth and early metastasis." .

### Property Definitions ###

kg:ageGroup a owl:DatatypeProperty ;
    rdfs:domain kg:SCLCPatient ;
    rdfs:range xsd:string ;
    rdfs:label "Age Group" ;
    rdfs:comment "Categorization of the patient's age. SCLC predominantly affects older individuals, typically presenting in the 6th to 8th decades of life." .

kg:gender a owl:DatatypeProperty ;
    rdfs:domain kg:SCLCPatient ;
    rdfs:range xsd:string ;
    rdfs:label "Gender" ;
    rdfs:comment "The gender/sex of the patient. Historically, SCLC has been more prevalent in males due to smoking trends, though the incidence in females has been rising." .

kg:smokerType a owl:DatatypeProperty ;
    rdfs:domain kg:SCLCPatient ;
    rdfs:range xsd:string ;
    rdfs:label "Smoker Type" ;
    rdfs:comment "The smoking status or history of the patient. This is a critical causal factor, as over 95% of SCLC patients have a history of heavy tobacco use." .

kg:familyCancer a owl:DatatypeProperty ;
    rdfs:domain kg:SCLCPatient ;
    rdfs:range xsd:string ;
    rdfs:label "Family History of Cancer" ;
    rdfs:comment "Indicates whether the patient has a family history of cancer, which may imply shared environmental risks (e.g., second-hand smoke) or genetic susceptibility." .

kg:biomarker a owl:DatatypeProperty ;
    rdfs:domain kg:SCLCPatient ;
    rdfs:range xsd:string ;
    rdfs:label "Biomarker" ;
    rdfs:comment "Clinical biomarkers associated with the SCLC tumor (e.g., NSE, ProGRP) or genetic alterations (e.g., ubiquitous TP53 and RB1 loss) relevant for diagnostic or prognostic purposes." .

kg:episodeType a owl:DatatypeProperty ;
    rdfs:domain kg:SCLCPatient ;
    rdfs:range xsd:string ;
    rdfs:label "Episode Type" ;
    rdfs:comment "The type of clinical episode (e.g., initial diagnosis, treatment response, progression). Crucial for tracking the rapid disease trajectory typical of SCLC." .

kg:relapseStatus a owl:DatatypeProperty ;
    rdfs:domain kg:SCLCPatient ;
    rdfs:range xsd:string ;
    rdfs:label "Relapse Status" ;
    rdfs:comment "Indicates whether the patient has experienced a relapse. Despite high initial response rates to chemo-radiotherapy, SCLC has an exceptionally high rate of early relapse." .

kg:locatedIn a owl:DatatypeProperty ;
    rdfs:domain kg:SCLCPatient ;
    rdfs:range xsd:string ;
    rdfs:label "Tumor Location" ;
    rdfs:comment "The anatomical location of the primary SCLC tumor (typically central airways) or sites of metastasis (frequently brain, liver, bone, and adrenal glands)." .

kg:stage a owl:DatatypeProperty ;
    rdfs:domain kg:SCLCPatient ;
    rdfs:range xsd:string ;
    rdfs:label "SCLC Stage" ;
    rdfs:comment "The stage of the disease. Often categorized using the VALG system (Limited-Stage vs. Extensive-Stage SCLC) or the standard TNM staging system." .

kg:familyGender a owl:DatatypeProperty ;
    rdfs:domain kg:SCLCPatient ;
    rdfs:range xsd:string ;
    rdfs:label "Gender of Affected Family Member" ;
    rdfs:comment "The gender of the family member who had a history of cancer, useful for specific epidemiological subgrouping and causal linkage analysis." .

<http://causalkg.example.org/sclc/patient/patient_0> a kg:SCLCPatient;
		kg:ageGroup "OLDER";
		kg:gender "Female";
		kg:smokerType "NonSmoker";
		kg:familyCancer "Major";
		kg:biomarker "ALKorEGFR";
		kg:episodeType "Others";
		kg:relapseStatus "Progression";
		kg:locatedIn "Region3";
		kg:stage "IV";
		kg:familyGender "Man".

