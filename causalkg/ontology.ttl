@prefix ckg: <http://sdm-causalkg.org/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ckg:CausalEdge a rdfs:Class ;
    rdfs:label "CausalEdge" ;
    rdfs:comment "A reified causal edge (v1, r, v2) with a method-assigned weight." .

ckg:CausalEstimate a rdfs:Class ;
    rdfs:label "CausalEstimate" ;
    rdfs:comment "Abstract: the answer to a ckg:CausalQuery." .

ckg:CausalModel a rdfs:Class ;
    rdfs:label "CausalModel" ;
    rdfs:comment "A fitted structural causal model (dowhy.gcm SCM) over an OntologicalCausalGraph." ;
    rdfs:subClassOf mls:Model .

ckg:CausalQuery a rdfs:Class ;
    rdfs:label "CausalQuery" ;
    rdfs:comment "Abstract: a query against a ckg:CausalModel. The query IRI is also the world IRI." .

ckg:Condition a rdfs:Class ;
    rdfs:label "Condition" ;
    rdfs:comment "An observed-value selector: evidence (conditional) or sub-population filter (hasCondition)." .

ckg:ConditionalEstimate a rdfs:Class ;
    rdfs:label "ConditionalEstimate" ;
    rdfs:comment "Answer to a ckg:ConditionalQuery." .

ckg:ConditionalQuery a rdfs:Class ;
    rdfs:label "ConditionalQuery" ;
    rdfs:comment "P(target | evidence[, condition]) — (sub-)population." .

ckg:CounterfactualEstimate a rdfs:Class ;
    rdfs:label "CounterfactualEstimate" ;
    rdfs:comment "Answer to a ckg:CounterfactualQuery." .

ckg:CounterfactualQuery a rdfs:Class ;
    rdfs:label "CounterfactualQuery" ;
    rdfs:comment "Entity-level counterfactual: what target would have been for aboutEntity." .

ckg:DiscoveryRun a rdfs:Class ;
    rdfs:label "DiscoveryRun" ;
    rdfs:comment "One execution of a causal-discovery method over one KG." .

ckg:IntervalEstimate a rdfs:Class ;
    rdfs:label "IntervalEstimate" ;
    rdfs:comment "Uncertainty hook for a continuous predictedValue: a credible interval." .

ckg:Intervention a rdfs:Class ;
    rdfs:label "Intervention" ;
    rdfs:comment "A do(node := value) or do(node := f(.)) act, optionally bound to onEntity." .

ckg:InterventionalEstimate a rdfs:Class ;
    rdfs:label "InterventionalEstimate" ;
    rdfs:comment "Answer to a ckg:InterventionalQuery." .

ckg:InterventionalQuery a rdfs:Class ;
    rdfs:label "InterventionalQuery" ;
    rdfs:comment "P(target | do(intervention)[, condition]) — (sub-)population." .

ckg:MechanismAssignment a rdfs:Class ;
    rdfs:label "MechanismAssignment" ;
    rdfs:comment "The causal mechanism (model class, invertibility, performance) assigned to one node." .

ckg:ModelFitRun a rdfs:Class ;
    rdfs:label "ModelFitRun" ;
    rdfs:comment "One execution of CausalModel.fit that produced a ckg:CausalModel." ;
    rdfs:subClassOf mls:Run .

ckg:NodeSlot a rdfs:Class ;
    rdfs:label "NodeSlot" ;
    rdfs:comment "One position of the column layout of adj: a (graph, index, node) triple." .

ckg:OntologicalCausalGraph a rdfs:Class ;
    rdfs:label "OntologicalCausalGraph" ;
    rdfs:comment "A discovered ontological causal graph G = (N, E_N)." .

ckg:Parameter a rdfs:Class ;
    rdfs:label "Parameter" ;
    rdfs:comment "One named hyper-parameter of a ckg:DiscoveryRun." .

ckg:PropertyNode a rdfs:Class ;
    rdfs:label "PropertyNode" ;
    rdfs:comment "A causal node (D_p, p, R_p): domain class, property, range." .

ckg:aboutEntity a rdf:Property ;
    rdfs:label "aboutEntity" ;
    rdfs:comment "Counterfactual only: the single entity the hypothetical world is about." .

ckg:artifact a rdf:Property ;
    rdfs:label "artifact" ;
    rdfs:comment "Filesystem path of the persisted model artifact (scm.pkl)." .

ckg:causalEffect a rdf:Property ;
    rdfs:label "causalEffect" ;
    rdfs:comment "Interventional only: contrast against ckg:referenceIntervention." .

ckg:cause a rdf:Property ;
    rdfs:label "cause" ;
    rdfs:comment "The ckg:PropertyNode acting as cause." .

ckg:computedAt a rdf:Property ;
    rdfs:label "computedAt" ;
    rdfs:comment "Timestamp the estimate was computed — the one provenance triple that survives (§6.6)." .

ckg:counterfactualCoupling a rdf:Property ;
    rdfs:label "counterfactualCoupling" ;
    rdfs:comment "Noise coupling used for counterfactuals ('gumbel-max' or 'ordinal')." .

ckg:credibleLevel a rdf:Property ;
    rdfs:label "credibleLevel" ;
    rdfs:comment "Credible level (e.g. 0.95) of a ckg:IntervalEstimate." .

ckg:diagnostics a rdf:Property ;
    rdfs:label "diagnostics" ;
    rdfs:comment "Optional hook (0..1): a JSON literal of backend/samples/ESS/coupling — run diagnostics, not world facts." .

ckg:domain a rdf:Property ;
    rdfs:label "domain" ;
    rdfs:comment "Domain class D_p of a property node." .

ckg:edgeCount a rdf:Property ;
    rdfs:label "edgeCount" ;
    rdfs:comment "Number of causal edges in the graph." .

ckg:effect a rdf:Property ;
    rdfs:label "effect" ;
    rdfs:comment "The ckg:PropertyNode acting as effect." .

ckg:epsilon rdfs:label "ε" ;
    rdfs:comment "Identity relation: an intra-entity (intra-class) causal transition." .

ckg:factualValue a rdf:Property ;
    rdfs:label "factualValue" ;
    rdfs:comment "Counterfactual only: what ckg:onNode actually *was* for ckg:onEntity in the source KG — the baseline ckg:predictedValue is a counterfactual to. Aggregated over the entity's rows when the flat join gave it several. The contrast is deliberately not minted: it is predictedValue - factualValue." .

ckg:forNode a rdf:Property ;
    rdfs:label "forNode" ;
    rdfs:comment "The ckg:PropertyNode a mechanism assignment describes." .

ckg:forQuery a rdf:Property ;
    rdfs:label "forQuery" ;
    rdfs:comment "The ckg:CausalQuery (== hypothetical world) this estimate answers." .

ckg:hasCondition a rdf:Property ;
    rdfs:label "hasCondition" ;
    rdfs:comment "The sub-population selector (CATE), e.g. E[Y | do(t), stage = III]." .

ckg:hasEdge a rdf:Property ;
    rdfs:label "hasEdge" ;
    rdfs:comment "Causal edge belonging to this causal graph." .

ckg:hasEvidence a rdf:Property ;
    rdfs:label "hasEvidence" ;
    rdfs:comment "Conditional only: a ckg:Condition read as observed evidence." .

ckg:hasIntervention a rdf:Property ;
    rdfs:label "hasIntervention" ;
    rdfs:comment "A ckg:Intervention applied in this query (1..n; several = joint intervention)." .

ckg:hasMechanism a rdf:Property ;
    rdfs:label "hasMechanism" ;
    rdfs:comment "A ckg:MechanismAssignment belonging to this model, one per node." .

ckg:hasNode a rdf:Property ;
    rdfs:label "hasNode" ;
    rdfs:comment "Property node belonging to this causal graph (the ckg:hasNodeSlot/ckg:slotNode shortcut)." .

ckg:hasNodeSlot a rdf:Property ;
    rdfs:label "hasNodeSlot" ;
    rdfs:comment "A ckg:NodeSlot of this graph: one column of adj." .

ckg:hasParameter a rdf:Property ;
    rdfs:label "hasParameter" ;
    rdfs:comment "A ckg:Parameter of this discovery run." .

ckg:hasQuery a rdf:Property ;
    rdfs:label "hasQuery" ;
    rdfs:comment "Entity-first navigation: a ckg:CausalQuery this entity is the subject of." .

ckg:inGraph a rdf:Property ;
    rdfs:label "inGraph" ;
    rdfs:comment "The causal graph this edge belongs to." .

ckg:invertible a rdf:Property ;
    rdfs:label "invertible" ;
    rdfs:comment "Whether the assigned mechanism is an InvertibleFunctionalCausalModel." .

ckg:library a rdf:Property ;
    rdfs:label "library" ;
    rdfs:comment "Modelling library, e.g. 'dowhy.gcm'." .

ckg:libraryVersion a rdf:Property ;
    rdfs:label "libraryVersion" ;
    rdfs:comment "Version of the modelling library used to fit the model." .

ckg:lowerBound a rdf:Property ;
    rdfs:label "lowerBound" ;
    rdfs:comment "Lower bound of a ckg:IntervalEstimate." .

ckg:manuallyAdded a rdf:Property ;
    rdfs:label "manuallyAdded" ;
    rdfs:comment "True iff a human added this edge during curation rather than a discovery method proposing it." .

ckg:mechanismType a rdf:Property ;
    rdfs:label "mechanismType" ;
    rdfs:comment "Class name of the assigned causal mechanism (e.g. InvertibleClassifierFCM)." .

ckg:method a rdf:Property ;
    rdfs:label "method" ;
    rdfs:comment "Name of the causal-discovery method (GES, NOTEARS, ...). On the ckg:DiscoveryRun; reach it from a graph via prov:wasGeneratedBy." .

ckg:nodeCount a rdf:Property ;
    rdfs:label "nodeCount" ;
    rdfs:comment "Number of property nodes in the graph." .

ckg:nodeKind a rdf:Property ;
    rdfs:label "nodeKind" ;
    rdfs:comment "'data' or 'object' — selects the variable type downstream." .

ckg:observedValue a rdf:Property ;
    rdfs:label "observedValue" ;
    rdfs:comment "The value a Condition observes." .

ckg:onEntity a rdf:Property ;
    rdfs:label "onEntity" ;
    rdfs:comment "The entity an Intervention (or a CounterfactualEstimate) targets. Present iff entity-level." .

ckg:onNode a rdf:Property ;
    rdfs:label "onNode" ;
    rdfs:comment "The ckg:PropertyNode an Intervention/Estimate targets." .

ckg:onProperty a rdf:Property ;
    rdfs:label "onProperty" ;
    rdfs:comment "Derived shortcut: the property IRI of ckg:onNode." .

ckg:overGraph a rdf:Property ;
    rdfs:label "overGraph" ;
    rdfs:comment "The ckg:OntologicalCausalGraph this model was fitted on." .

ckg:parameterKind a rdf:Property ;
    rdfs:label "parameterKind" ;
    rdfs:comment "'str' | 'int' | 'float' | 'bool' | 'null' | 'json' — how to read ckg:parameterValue." .

ckg:parameterName a rdf:Property ;
    rdfs:label "parameterName" ;
    rdfs:comment "Name of a hyper-parameter, e.g. 'alpha' or 'seed'." .

ckg:parameterValue a rdf:Property ;
    rdfs:label "parameterValue" ;
    rdfs:comment "Value of a hyper-parameter, as text; read with ckg:parameterKind." .

ckg:performance a rdf:Property ;
    rdfs:label "performance" ;
    rdfs:comment "Held-out performance value of the mechanism (from gcm.evaluate_causal_model)." .

ckg:performanceMetric a rdf:Property ;
    rdfs:label "performanceMetric" ;
    rdfs:comment "Name of the metric ckg:performance is measured in (F1, R2, ...)." .

ckg:predictedValue a rdf:Property ;
    rdfs:label "predictedValue" ;
    rdfs:comment "The answer: one modality-polymorphic value term for both categorical and continuous targets." .

ckg:predictionModel a rdf:Property ;
    rdfs:label "predictionModel" ;
    rdfs:comment "Class name of the underlying prediction model gcm.auto selected." .

ckg:probability a rdf:Property ;
    rdfs:label "probability" ;
    rdfs:comment "Probability of the ckg:predictedValue actually reported — i.e. of the arg-max level, not of some level named elsewhere. Categorical and ordinal nodes only: a Gumbel-max counterfactual is a genuine draw from the noise posterior, so this number is real. A continuous node's counterfactual is a deterministic inversion and carries no probability." .

ckg:property a rdf:Property ;
    rdfs:label "property" ;
    rdfs:comment "The property p of a property node." .

ckg:randomSeed a rdf:Property ;
    rdfs:label "randomSeed" ;
    rdfs:comment "The seed that produced this world's stochastic draws. Present iff the model was fitted with a random_state, which is what makes a Gumbel-max counterfactual reproducible rather than merely coupled." .

ckg:range a rdf:Property ;
    rdfs:label "range" ;
    rdfs:comment "Range R_p of a property node: a class when ckg:nodeKind is 'object', a datatype when it is 'data'. One term for both, as rdfs:range is — but deliberately *not* rdfs:range, whose RDFS entailment types its subject as an rdf:Property and intersects multiple domains globally, while (D_p, p, R_p) is a local, per-node scoping of p." .

ckg:referenceIntervention a rdf:Property ;
    rdfs:label "referenceIntervention" ;
    rdfs:comment "Interventional only: the baseline arm of a contrast." .

ckg:rowCount a rdf:Property ;
    rdfs:label "rowCount" ;
    rdfs:comment "How many flat-join rows the unit of this world occupied. 1 means any ckg:standardDeviation is purely counterfactual uncertainty (propagated from a stochastic categorical ancestor, or 0 when the node has none). Greater than 1 means the flat join duplicated the unit, and that duplication is mixed inseparably into the spread — the number is then a lower-confidence quantity, not a clean posterior sd." .

ckg:setExpression a rdf:Property ;
    rdfs:label "setExpression" ;
    rdfs:comment "do(): a soft-intervention expression (source text) an Intervention applies." .

ckg:setValue a rdf:Property ;
    rdfs:label "setValue" ;
    rdfs:comment "do(): the atomic value an Intervention sets its node to." .

ckg:slotIndex a rdf:Property ;
    rdfs:label "slotIndex" ;
    rdfs:comment "0-based column position of a ckg:NodeSlot in adj." .

ckg:slotNode a rdf:Property ;
    rdfs:label "slotNode" ;
    rdfs:comment "The ckg:PropertyNode occupying a ckg:NodeSlot." .

ckg:sourceKG a rdf:Property ;
    rdfs:label "sourceKG" ;
    rdfs:comment "The knowledge graph the data was materialized from." .

ckg:standardDeviation a rdf:Property ;
    rdfs:label "standardDeviation" ;
    rdfs:comment "Spread of a continuous ckg:predictedValue across the draws it was summarised from. Read it together with ckg:rowCount, which says whether that spread can be trusted as uncertainty: see the note on ckg:rowCount." .

ckg:targetNode a rdf:Property ;
    rdfs:label "targetNode" ;
    rdfs:comment "The ckg:PropertyNode targeted as the outcome (1..n)." .

ckg:targetProperty a rdf:Property ;
    rdfs:label "targetProperty" ;
    rdfs:comment "Derived shortcut: the property IRI of ckg:targetNode." .

ckg:trainedOn a rdf:Property ;
    rdfs:label "trainedOn" ;
    rdfs:comment "Source knowledge graph the model's data was materialized from." .

ckg:trainingRows a rdf:Property ;
    rdfs:label "trainingRows" ;
    rdfs:comment "Number of flat-join rows used to fit the model." .

ckg:upperBound a rdf:Property ;
    rdfs:label "upperBound" ;
    rdfs:comment "Upper bound of a ckg:IntervalEstimate." .

ckg:usedModel a rdf:Property ;
    rdfs:label "usedModel" ;
    rdfs:comment "The ckg:CausalModel that answered this query." .

ckg:usedTopologicalConstraint a rdf:Property ;
    rdfs:label "usedTopologicalConstraint" ;
    rdfs:comment "Whether the run enforced Assumption 1." .

ckg:viaPath a rdf:Property ;
    rdfs:label "viaPath" ;
    rdfs:comment "The edge's relation label as one SPARQL 1.1 property path, e.g. '^<.../treatedAt>/<.../receives>' — '^' is an inverse traversal and '/' a sequence. Present only when the ordered, directed form carries information ckg:viaRelation does not: a multi-hop join, or a single inverse hop. Absent for a plain forward hop and for ckg:epsilon." .

ckg:viaRelation a rdf:Property ;
    rdfs:label "viaRelation" ;
    rdfs:comment "Object property traversed by the edge; ckg:epsilon intra-class. Unordered: the set of properties the edge's join touches." .

ckg:weight a rdf:Property ;
    rdfs:label "weight" ;
    rdfs:comment "Method-assigned strength of the edge (coefficient or score)." .

