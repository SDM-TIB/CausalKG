ckg:hasEdge a rdf:Property ;
    rdfs:label "hasEdge" ;
    rdfs:comment "Causal edge belonging to this causal graph." .

ckg:hasNode a rdf:Property ;
    rdfs:label "hasNode" ;
    rdfs:comment "Property node belonging to this causal graph." .

ckg:hop a rdf:Property ;
    rdfs:label "hop" ;
    rdfs:comment "A step of a ckg:RelationPath." .

ckg:hopDirection a rdf:Property ;
    rdfs:label "hopDirection" ;
    rdfs:comment "'forward' or 'inverse' traversal of a hop." .

ckg:hopIndex a rdf:Property ;
    rdfs:label "hopIndex" ;
    rdfs:comment "1-based position of a hop in its path." .

ckg:hopRelation a rdf:Property ;
    rdfs:label "hopRelation" ;
    rdfs:comment "Object property traversed by a hop." .

ckg:inGraph a rdf:Property ;
    rdfs:label "inGraph" ;
    rdfs:comment "The causal graph this edge belongs to." .

ckg:method a rdf:Property ;
    rdfs:label "method" ;
    rdfs:comment "Name of the causal-discovery method (GES, NOTEARS, ...)." .

ckg:nodeCount a rdf:Property ;
    rdfs:label "nodeCount" ;
    rdfs:comment "Number of property nodes in the graph." .

ckg:nodeKind a rdf:Property ;
    rdfs:label "nodeKind" ;
    rdfs:comment "'data' or 'object' — selects the variable type downstream." .

ckg:nodeList a rdf:Property ;
    rdfs:label "nodeList" ;
    rdfs:comment "Ordered list of the property nodes: the column layout of adj." .

ckg:parameters a rdf:Property ;
    rdfs:label "parameters" ;
    rdfs:comment "Hyper-parameters of the run, as a canonical JSON object." .

ckg:pathLength a rdf:Property ;
    rdfs:label "pathLength" ;
    rdfs:comment "Number of hops in a ckg:RelationPath." .

ckg:property a rdf:Property ;
    rdfs:label "property" ;
    rdfs:comment "The property p of a property node." .

ckg:rangeClass a rdf:Property ;
    rdfs:label "rangeClass" ;
    rdfs:comment "Range class R_p of an object-property node." .

ckg:rangeDatatype a rdf:Property ;
    rdfs:label "rangeDatatype" ;
    rdfs:comment "Range datatype R_p of a data-property node." .

ckg:relationDirection a rdf:Property ;
    rdfs:label "relationDirection" ;
    rdfs:comment "'forward' or 'inverse' traversal of ckg:viaRelation." .

ckg:relationLabel a rdf:Property ;
    rdfs:label "relationLabel" ;
    rdfs:comment "Human-readable relation label of the edge." .

ckg:sourceKG a rdf:Property ;
    rdfs:label "sourceKG" ;
    rdfs:comment "The knowledge graph the data was materialized from." .

ckg:usedTopologicalConstraint a rdf:Property ;
    rdfs:label "usedTopologicalConstraint" ;
    rdfs:comment "Whether the run enforced the topological constraint." .

ckg:viaPath a rdf:Property ;
    rdfs:label "viaPath" ;
    rdfs:comment "A multi-hop relation label of the edge." .

ckg:viaRelation a rdf:Property ;
    rdfs:label "viaRelation" ;
    rdfs:comment "Object property traversed by the edge; ckg:epsilon intra-class." .

ckg:weight a rdf:Property ;
    rdfs:label "weight" ;
    rdfs:comment "Method-assigned strength of the edge (coefficient or score)." .

