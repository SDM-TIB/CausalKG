@prefix ckg: <http://sdm-causalkg.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ckg:CausalEdge a rdfs:Class ;
    rdfs:label "CausalEdge" ;
    rdfs:comment "A reified causal edge (v1, r, v2) with a method-assigned weight." .

ckg:DiscoveryRun a rdfs:Class ;
    rdfs:label "DiscoveryRun" ;
    rdfs:comment "One execution of a causal-discovery method over one KG." .

ckg:OntologicalCausalGraph a rdfs:Class ;
    rdfs:label "OntologicalCausalGraph" ;
    rdfs:comment "A discovered ontological causal graph G = (N, E_N)." .

ckg:PropertyNode a rdfs:Class ;
    rdfs:label "PropertyNode" ;
    rdfs:comment "A causal node (D_p, p, R_p): domain class, property, range." .

ckg:RelationHop a rdfs:Class ;
    rdfs:label "RelationHop" ;
    rdfs:comment "One (relation, direction) step inside a ckg:RelationPath." .

ckg:RelationPath a rdfs:Class ;
    rdfs:label "RelationPath" ;
    rdfs:comment "An ordered multi-hop relation label on a causal edge." .

ckg:cause a rdf:Property ;
    rdfs:label "cause" ;
    rdfs:comment "The ckg:PropertyNode acting as cause." .

ckg:constrained a rdf:Property ;
    rdfs:label "constrained" ;
    rdfs:comment "Whether Assumption 1 was enforced during discovery." .

ckg:domainClass a rdf:Property ;
    rdfs:label "domainClass" ;
    rdfs:comment "Domain class D_p of a property node." .

ckg:edgeCount a rdf:Property ;
    rdfs:label "edgeCount" ;
    rdfs:comment "Number of causal edges in the graph." .

ckg:effect a rdf:Property ;
    rdfs:label "effect" ;
    rdfs:comment "The ckg:PropertyNode acting as effect." .

