# Copy to `algs/.env` and fill in whichever provider you actually use.
#
# These keys are read by the *server* process only — `algs/ges_prior/llm_call.py`
# loads this file, and `service/api/main.py` reports which variable it found
# without ever returning the value. The web UI has no API-key field by design.
#
# Only the GES-Prior discovery method and the "Estimate priors" panel need a
# key. Every other method, the model fitting, and all inference run offline.
#
# `algs/.env` is in .gitignore. Keep it that way.

# --- OpenAI-compatible providers -------------------------------------------
# DeepSeek is the default (DEFAULT_LLM_MODEL = "deepseek-v4-flash").
DEEPSEEK_KEY=
OPENAI_API_KEY=
KIMI_KEY=
GLM_KEY=

# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Catch-all --------------------------------------------------------------
# Used when no provider-specific variable matches the model you selected.
LLM_API_KEY=
